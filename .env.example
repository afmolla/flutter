# Ayfleks — yerel geliştirme
# Bu dosyayı kopyalayın: cp .env.example .env.local

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SALON_AD=Ayfleks Ambalaj

# Panel girişi (/panel)
PANEL_PASSWORD=demo123

# Oturum imzası — üretimde en az 32 karakter rastgele (openssl rand -hex 32)
SESSION_SECRET=ayfleks-dev-session-secret-change-in-production-32chars

# --- Canlı (henüz kullanılmıyor) ---
# NEXT_PUBLIC_SITE_URL=https://ayfleks.com
